{
  "name": "@tarjim/browser",
  "version": "0.1.0",
  "private": true,
  "description": "The browser half of the Tarjim web SDK: storage, cross-tab locking and the script-tag build.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tarjim/core": "workspace:*"
  }
}
