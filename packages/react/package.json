{
  "name": "@tarjim/react",
  "version": "0.1.0-alpha.3",
  "description": "React bindings for the Tarjim web SDK: a provider and a hook.",
  "license": "MIT",
  "keywords": ["tarjim", "i18n", "translations"],
  "homepage": "https://github.com/Tarjim-io/tarjim-js/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/Tarjim-io/tarjim-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tarjim-io/tarjim-js.git",
    "directory": "packages/react"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tarjim/browser": "workspace:*",
    "@tarjim/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-18": "npm:react@18.3.1",
    "react-dom": "19.3.0",
    "react-dom-18": "npm:react-dom@18.3.1"
  }
}
