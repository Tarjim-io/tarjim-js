{
  "name": "@tarjim/core",
  "version": "0.1.0",
  "description": "The runtime-agnostic core of the Tarjim web SDK: delivery protocol, verification and lookups.",
  "license": "MIT",
  "keywords": ["tarjim", "i18n", "translations"],
  "homepage": "https://github.com/Tarjim-io/tarjim-js/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Tarjim-io/tarjim-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tarjim-io/tarjim-js.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  }
}
